# Maintainer: mochios team
pkgname=mochios-defaults
pkgver=0.1.0
pkgrel=5
pkgdesc="mochios default system configuration files"
arch=('any')
url="https://mochios.dev"
license=('GPL3')
depends=('zsh' 'sudo' 'btrfs-progs' 'waybar' 'dunst' 'wofi' 'hyprpaper')
optdepends=('greetd: TUI greeter' 'ly: TUI greeter')
source=("mochios-defaults-$pkgver.tar.gz")
sha256sums=('SKIP')

package() {
  cd "$srcdir"
  install -Dm644 mochios-release "$pkgdir/etc/mochios-release"
  echo "$pkgver-$pkgrel" > "$pkgdir/etc/mochios-defaults-version"
  install -Dm755 usr/bin/mochi-wallpaper "$pkgdir/usr/bin/mochi-wallpaper"
  install -Dm644 etc/xdg/autostart/mochi-wallpaper.desktop "$pkgdir/etc/xdg/autostart/mochi-wallpaper.desktop"
  install -Dm644 etc/xdg/kwinrc "$pkgdir/etc/xdg/kwinrc"

  # hyprland
  install -Dm644 etc/skel/.config/hypr/hyprland.lua "$pkgdir/etc/skel/.config/hypr/hyprland.lua"
  install -Dm644 etc/skel/.config/hypr/hyprpaper.conf "$pkgdir/etc/skel/.config/hypr/hyprpaper.conf"

  # waybar
  install -Dm644 etc/skel/.config/waybar/config "$pkgdir/etc/skel/.config/waybar/config"
  install -Dm644 etc/skel/.config/waybar/style.css "$pkgdir/etc/skel/.config/waybar/style.css"

  # dunst
  install -Dm644 etc/skel/.config/dunst/dunstrc "$pkgdir/etc/skel/.config/dunst/dunstrc"

  # wofi
  install -Dm644 etc/skel/.config/wofi/config "$pkgdir/etc/skel/.config/wofi/config"
  install -Dm644 etc/skel/.config/wofi/style.css "$pkgdir/etc/skel/.config/wofi/style.css"

  # greetd
  install -Dm644 etc/greetd/config "$pkgdir/etc/greetd/config"

  # ly
  install -Dm644 etc/ly/config.ini "$pkgdir/etc/ly/config.ini"
}
